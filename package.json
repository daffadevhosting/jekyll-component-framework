{
  "name": "thicket-ui",
  "version": "1.4.7",
  "type": "module",
  "description": "A hybrid component and utility framework for Jekyll and the web.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daffadevhosting/jekyll-component-framework.git"
  },
  "homepage": "https://daffadevhosting.github.io/jekyll-component-framework/",
  "keywords": [
    "css",
    "scss",
    "design-system",
    "jekyll",
    "liquid",
    "components",
    "utilities",
    "mcp"
  ],
  "style": "dist/thicket.css",
  "sass": "assets/scss/thicket.scss",
  "exports": {
    "./css": "./dist/thicket.css",
    "./scss": "./assets/scss/thicket.scss",
    "./js": "./assets/js/main.js"
  },
  "bin": {
    "thicket": "./scripts/thicket.mjs"
  },
  "files": [
    "dist/",
    "assets/scss/",
    "assets/js/",
    "scripts/thicket.mjs",
    "_includes/components/",
    "_includes/icon.html",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:css",
    "build:css": "sass --no-source-map --load-path=assets/scss assets/scss/thicket.scss dist/thicket.css",
    "prepack": "npm run build:css",
    "test": "node --test scripts/*.test.mjs",
    "test:components": "node --test scripts/component-api.test.mjs scripts/component-mcp-tools.test.mjs",
    "test:liquid": "node --test scripts/liquid-components.test.mjs",
    "test:js": "node --test scripts/javascript-interactions.test.mjs",
    "test:a11y": "node --test scripts/accessibility.test.mjs",
    "test:purge": "node scripts/thicket.mjs purge --help && node --test scripts/thicket.purge.test.mjs",
    "test:package": "node --test scripts/npm-package.test.mjs",
    "benchmark:purge": "node scripts/thicket.bench.mjs",
    "mcp": "npx -y jekyll-component-mcp --root .",
    "mcp:components": "node scripts/thicket-component-mcp.mjs --root ."
  },
  "engines": {
    "node": "18 || 20 || >=22"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "axe-core": "^4.10.3",
    "jekyll-component-mcp": "^1.5.0",
    "jsdom": "^26.1.0",
    "sass": "^1.93.2",
    "zod": "^4.6.6"
  },
  "dependencies": {
    "glob": "^14.0.6",
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
