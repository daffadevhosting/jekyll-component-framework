{
  "name": "thicket-ui",
  "version": "1.4.1",
  "description": "A hybrid component and utility framework for Jekyll and the web.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daffadevhosting/jekyll-component-framework.git"
  },
  "homepage": "https://daffadevhosting.github.io/jekyll-component-framework/",
  "keywords": [
    "css",
    "scss",
    "design-system",
    "jekyll",
    "liquid",
    "components",
    "utilities",
    "mcp"
  ],
  "style": "dist/thicket.css",
  "sass": "assets/scss/thicket.scss",
  "exports": {
    "./css": "./dist/thicket.css",
    "./scss": "./assets/scss/thicket.scss",
    "./js": "./assets/js/main.js"
  },
  "bin": {
    "thicket": "./scripts/thicket.mjs"
  },
  "files": [
    "dist/",
    "assets/scss/",
    "assets/js/",
    "scripts/",
    "_includes/components/",
    "README.md",
    "LICENSE",
    ".mcp.json"
  ],
  "scripts": {
    "build:css": "sass --no-source-map --load-path=assets/scss assets/scss/thicket.scss dist/thicket.css",
    "prepack": "npm run build:css",
    "test:purge": "node scripts/thicket.mjs purge --help && node --test scripts/thicket.purge.test.mjs",
    "mcp": "npx -y jekyll-component-mcp --root ."
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "glob": "^13.0.6",
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6",
    "sass": "^1.93.2"
  },
  "optionalDependencies": {
    "jekyll-component-mcp": "^1.2.2"
  }
}
