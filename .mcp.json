{
  "mcpServers": {
    "jekyll-component": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "jekyll-component-mcp",
        "--root",
        "."
      ],
      "tools": ["*"]
    },
    "thicket-components": {
      "type": "local",
      "command": "node",
      "args": [
        "scripts/thicket-component-mcp.mjs",
        "--root",
        "."
      ],
      "tools": ["*"]
    }
  }
}
